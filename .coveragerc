[run]
branch = True
source =
    shared
    services/management/app
omit =
    */tests/*
    */test_*
    */__pycache__/*
    */migrations/*
    */alembic/*
    */conftest.py
    */wsgi.py
    */proto/*
    *_pb2.py
    *_pb2_grpc.py
    shared/py_libs/*
    services/management/app/grpc/proto/*
    # 2026-08-21 coverage audit: 0 dedicated tests, 1229 lines -- deliberate
    # deferral, decide in Stage 1 whether to test or knowingly keep deferred.
    shared/utils/rag_integration.py

[report]
fail_under = 74
show_missing = True
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    \.\.\.

[html]
directory = htmlcov

[xml]
output = coverage.xml
