[flake8]
max-line-length = 120
extend-ignore =
    # Black and flake8 disagree on slice whitespace — Black wins
    E203,
    # Black and flake8 disagree on line breaks around binary operators
    W503,
exclude =
    .git,
    __pycache__,
    venv,
    .venv,
    node_modules,
    */grpc_proto/*,
    */grpc/proto/*,
    */proto/*,
    *_pb2.py,
    *_pb2_grpc.py
per-file-ignores =
    # Allow sys.path manipulation before imports in entry points
    management/apps/*/main.py: E402
    proxy/apps/*/main.py: E402
    examples/*.py: E402
    # scripts — match both with and without leading ./
    scripts/*.py: E402
    */scripts/*.py: E402
    # Allow out-of-order imports in alembic env (needed for migration setup)
    services/management/alembic/env.py: E402
    */services/management/alembic/env.py: E402
    # Allow re-export imports in package __init__ files
    services/management/app/api/v1/__init__.py: F401,E402
    services/management/app/__init__.py: F401
    # Allow E402 in penguincode CLI modules with sys.path manipulation
    services/penguincode/penguincode_cli/agents/base.py: E402
    services/penguincode/tests/test_planning.py: E402
    services/penguincode/tests/test_tools.py: E402
    services/penguincode/tests/test_usage.py: E402
    # Allow E402 in test infrastructure with sys.path manipulation
    tests/conftest.py: E402
    tests/unit/management/test_marchproxy_config.py: E402
    # Suppress E501 for test files with long assertion strings
    tests/penguincode/tests/test_ollama.py: E501
    # Allow wildcard imports in proto __init__ files (re-export pattern)
    */grpc_proto/*/__init__.py: F401,F403
    */grpc/proto/*/__init__.py: F401,F403
    # LLM prompt strings legitimately exceed line length
    services/penguincode/penguincode_cli/agents/prompts.py: E501
    services/penguincode/penguincode_cli/agents/executor.py: E501
    services/penguincode/penguincode_cli/agents/docs.py: E501
    services/penguincode/penguincode_cli/agents/chat.py: E501
    services/penguincode/penguincode_cli/agents/debugger.py: E501
    services/penguincode/penguincode_cli/agents/base.py: E501
    services/penguincode/penguincode_cli/agents/planner.py: E501
    services/penguincode/penguincode_cli/agents/refactor.py: E501
    services/penguincode/penguincode_cli/agents/researcher.py: E501
    services/penguincode/penguincode_cli/proto/__init__.py: E501
    # Seed/migration scripts have long data strings
    scripts/seed_security_rag.py: E501
